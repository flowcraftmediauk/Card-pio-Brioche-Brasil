rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validation blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'email']) &&
             data.keys().hasOnly(['userId', 'displayName', 'email', 'photoURL', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.userId is string && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 100 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidFavorite(data) {
      return data.keys().hasAll(['userId', 'productId', 'productName']) &&
             data.keys().hasOnly(['userId', 'productId', 'productName', 'category', 'price', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.userId is string && data.userId.size() <= 128 &&
             data.productId is string && data.productId.size() <= 100 &&
             data.productName is string && data.productName.size() <= 120 &&
             (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
             (!('price' in data) || (data.price is string && data.price.size() <= 40)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['userId', 'customerName', 'customerPhone', 'itemsSummary', 'status']) &&
             data.keys().hasOnly(['userId', 'customerName', 'customerPhone', 'pickupDate', 'pickupTime', 'itemsSummary', 'notes', 'status', 'createdAt']) &&
             data.userId == request.auth.uid &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.customerPhone is string && data.customerPhone.size() <= 30 &&
             data.itemsSummary is string && data.itemsSummary.size() <= 5000 &&
             data.status in ['pending', 'confirmed', 'cancelled'] &&
             (!('pickupDate' in data) || (data.pickupDate is string && data.pickupDate.size() <= 20)) &&
             (!('pickupTime' in data) || (data.pickupTime is string && data.pickupTime.size() <= 20)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 50));
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().userId == existing().userId;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User favorites subcollection
      match /favorites/{favId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(favId);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(favId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(favId);
      }
    }

    // Orders / Encomendas
    match /orders/{orderId} {
      allow get: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(orderId) && isValidOrder(incoming());
      allow update: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid && isValidOrder(incoming()) && incoming().userId == existing().userId && incoming().diff(existing()).affectedKeys().hasOnly(['notes', 'status', 'pickupDate', 'pickupTime']);
      allow delete: if isSignedIn() && isValidId(orderId) && resource.data.userId == request.auth.uid;
    }
  }
}
